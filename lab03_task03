        Scanner input = new Scanner(System.in);
        System.out.print("Enter the No of Students of Desk a: ");
        int a = input.nextInt();
        System.out.print("Enter the No of Students of Desk b: ");
        int b = input.nextInt();
        System.out.print("Enter the No of Students of Desk c: ");
         int c = input.nextInt();
    
